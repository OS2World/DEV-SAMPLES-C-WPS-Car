/*
 * Class Creation and Initialization
 */

SOMClass * SOMLINK CarNewClass (integer4 somtmajorVersion,
		integer4 somtminorVersion)
{
    SOMClass *result;

    if (_Car && _somCheckVersion(_Car, somtmajorVersion, somtminorVersion))
          return _Car;
    WPDataFileNewClass(WPDataFile_MajorVersion,WPDataFile_MinorVersion);	/* static reference */
    /* Explicit metaclass, so get it */ 
    M_CarNewClass(M_Car_MajorVersion,M_Car_MinorVersion);	/* static reference */
    result = somBuildClass(0xFFFFFFFF,&CarSCI, somtmajorVersion, somtminorVersion);
    Car_parent_WPDataFile_wpSetup_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpSetup); 
    Car_parent_WPDataFile_wpOpen_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpOpen); 
    Car_parent_WPDataFile_wpQueryDetailsData_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpQueryDetailsData); 
    Car_parent_WPDataFile_wpMenuItemHelpSelected_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpMenuItemHelpSelected); 
    Car_parent_WPDataFile_wpMenuItemSelected_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpMenuItemSelected); 
    Car_parent_WPDataFile_wpModifyPopupMenu_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpModifyPopupMenu); 
    Car_parent_WPDataFile_wpFilterPopupMenu_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpFilterPopupMenu); 
    Car_parent_WPDataFile_wpAddSettingsPages_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpAddSettingsPages); 
    Car_parent_WPDataFile_wpRestoreState_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpRestoreState); 
    Car_parent_WPDataFile_wpSaveState_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpSaveState); 
    Car_parent_WPDataFile_wpUnInitData_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpUnInitData); 
    Car_parent_WPDataFile_wpInitData_resolved = 
	somParentNumResolve(CarCClassData.parentMtab, 1, WPObjectClassData.wpInitData); 
    return result;
}

