/*
 * Class Creation and Initialization
 */

SOMClass * SOMLINK M_CarNewClass (integer4 somtmajorVersion,
		integer4 somtminorVersion)
{
    SOMClass *result;

    if (_M_Car && _somCheckVersion(_M_Car, somtmajorVersion, somtminorVersion))
          return _M_Car;
    M_WPDataFileNewClass(M_WPDataFile_MajorVersion,M_WPDataFile_MinorVersion);	/* static reference */
    result = somBuildClass(0xFFFFFFFF,&M_CarSCI, somtmajorVersion, somtminorVersion);
    M_Car_parent_M_WPDataFile_wpclsQueryStyle_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryStyle); 
    M_Car_parent_M_WPDataFile_wpclsQueryInstanceFilter_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPFileSystemClassData.wpclsQueryInstanceFilter); 
    M_Car_parent_M_WPDataFile_wpclsQueryDetails_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryDetails); 
    M_Car_parent_M_WPDataFile_wpclsQueryDetailsInfo_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryDetailsInfo); 
    M_Car_parent_M_WPDataFile_wpclsQueryDefaultView_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryDefaultView); 
    M_Car_parent_M_WPDataFile_wpclsQueryDefaultHelp_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryDefaultHelp); 
    M_Car_parent_M_WPDataFile_wpclsQueryIconData_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryIconData); 
    M_Car_parent_M_WPDataFile_wpclsQueryTitle_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryTitle); 
    M_Car_parent_M_WPDataFile_wpclsUnInitData_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPObjectClassData.wpclsUnInitData); 
    M_Car_parent_M_WPDataFile_wpclsInitData_resolved = 
	somParentNumResolve(M_CarCClassData.parentMtab, 1, M_WPObjectClassData.wpclsInitData); 
    return result;
}

