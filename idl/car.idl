/*
 * car.idl - Workplace Shell sample "Car" object class.
 *
 * Watcom port of IBM's 1993/94 SOM 2.x sample (orig\car.idl).  Changes
 * from the original:
 *   - dllname added to both implementation blocks (modern sc wants the
 *     DLL name recorded in the bindings so _somLocateClassFile and the
 *     WPS agree on where the class lives);
 *   - otherwise structurally identical: Car derives from WPDataFile,
 *     metaclass M_Car carries clsQueryModuleHandle plus the wpcls*
 *     overrides.
 *
 * CLASS HIERARCHY:
 *
 *     SOMObject
 *       +- WPObject
 *            +- WPFileSystem
 *                 +- WPDataFile
 *                      +- Car
 */

#ifndef car_idl
#define car_idl

#include <wpdataf.idl>
#include <somcls.idl>

interface M_Car;

interface Car : WPDataFile
{
   BOOL QueryBrakes();
   /* METHOD: QueryBrakes
    *   Query state of car's brakes.
    * RETURN:
    *   TRUE           Brake is on
    *   FALSE          Brake is off
    */

   VOID SetBrakes(in BOOL fBrake);
   /* METHOD: SetBrakes - put on the brakes */

   ULONG QueryDuration();
   /* METHOD: QueryDuration - query duration of horn beep */

   VOID SetDuration(in ULONG ulDuration);
   /* METHOD: SetDuration - set duration of horn beep */

   ULONG QueryHighTone();
   /* METHOD: QueryHighTone - query high frequency of horn */

   VOID SetHighTone(in ULONG ulTone);
   /* METHOD: SetHighTone - set high frequency of horn */

   ULONG QueryLowTone();
   /* METHOD: QueryLowTone - query low frequency of horn */

   VOID SetLowTone(in ULONG ulTone);
   /* METHOD: SetLowTone - set low frequency of horn */

   ULONG QuerySpeed();
   /* METHOD: QuerySpeed - query speed of car */

   VOID SetSpeed(in ULONG ulSpeed);
   /* METHOD: SetSpeed - set speed of car */

   BOOL BeepHorn();
   /* METHOD: BeepHorn - beep the car's horn.
    * RETURN: TRUE successful, FALSE unsuccessful */

   ULONG AddDashboardPage(in HWND hwndNotebook);
   /* METHOD: AddDashboardPage - add the dashboard page to the settings
    * notebook.  Returns the inserted page id, or 0 on failure.
    * Override to replace/remove the dashboard page in descendants;
    * such overrides usually do not call the parent. */

   ULONG AddHornBeepPage(in HWND hwndNotebook);
   /* METHOD: AddHornBeepPage - add the horn beep page to the settings
    * notebook.  Same return/override conventions as AddDashboardPage. */

   VOID TrapTest();
   /* METHOD: TrapTest - demonstrates the sample's exception handling
    * by deliberately causing an access violation. */

#ifdef __SOMIDL__
   implementation
   {
      releaseorder: QueryBrakes,SetBrakes,QueryDuration,SetDuration,
                    QueryHighTone,SetHighTone,QueryLowTone,SetLowTone,
                    QuerySpeed,SetSpeed,BeepHorn,AddDashboardPage,
                    AddHornBeepPage,TrapTest;

      externalstem   = car;
      externalprefix = car_;
      majorversion   = 1;
      minorversion   = 2;
      filestem       = car;
      metaclass      = M_Car;
      callstyle      = oidl;
      dllname        = "car.dll";

      /* C_ih: prelude emitted at the top of car.ih - OS/2 types before
       * anything else (the PM headers assume os2.h came first), plus
       * every ID the resources and implementation share.
       * NOTE TO MAINTAINERS: toolkit 4.5's os2.h no longer pulls in
       * pmstddlg.h, but CDATE (CARDETAILS below) lives there - keep
       * that include.  sc forbids comments between statement tokens,
       * so such notes go here above the passthru or inside strings. */
      passthru C_ih =
"#define INCL_WIN"
"#define INCL_DOS"
"#define INCL_GPIBITMAPS"
"#define INCL_DOSERRORS"
"#include <os2.h>"
""
"#define INCL_WPCLASS"
"#define INCL_WPFOLDER"
""
"#include <pmwp.h>"
"/* Toolkit 4.5: os2.h does not pull in pmstddlg.h; CDATE lives there. */"
"#include <pmstddlg.h>"
""
"#define ID_TITLE           100"
"#define ID_ICON            101"
""
"#define IDD_DASHBOARD      200                  /* settings page */"
"#define IDD_HORNBEEP       202"
"#define IDD_DASHBOARD2    1200                  /* settings page */"
"#define IDD_HORNBEEP2     1202"
""
"/* User-defined popup menu items must be above WPMENUID_USER."
" * ID_OPENMENU becomes a submenu of the system open menu,"
" * WPMENUID_OPEN."
" */"
"#define ID_BEEPMENU        (WPMENUID_USER+1)"
"#define ID_OPENMENU        (WPMENUID_USER+2)"
"#define ID_TRAPMENU        (WPMENUID_USER+3)"
""
"#define IDM_OPENCAR        (WPMENUID_USER+4)"
"#define IDM_BEEPHORN       (WPMENUID_USER+5)"
"#define IDM_TRAPCAR        (WPMENUID_USER+6)"
""
"#define IDMSG_ACCESS_VIOLATION  100"
"#define IDM_MSGBOX              999"
""
"#define ID_FRAME           3000                   /* frame window id */"
"#define ID_CLIENT          3001                   /* client window id */"
""
"/* Unique view ids */"
"#define OPEN_CAR           IDM_OPENCAR"
""
"#define CAR_TIMER          1001                   /* timer id */"
""
"/* IDs of dialog items in CAR.RC */"
"#define ID_UNDO            801"
"#define ID_DEFAULT         802"
"#define ID_HELP            803"
"#define ID_HITONE          804"
"#define ID_LOTONE          805"
"#define ID_SPEEDSLIDER     806"
"#define ID_STOP            807"
"#define ID_SPEEDDATA       808"
"#define ID_GO              809"
""
"/* Keys for save-restore methods */"
"#define IDKEY_HITONE       1"
"#define IDKEY_LOTONE       2"
"#define IDKEY_DURATION     3"
"#define IDKEY_SPEED        4"
"#define IDKEY_BRAKEFLAG    5"
""
"/* Default values of instance data items */"
"#define DEFAULT_DURATION   300"
"#define DEFAULT_HITONE     400"
"#define DEFAULT_LOTONE     400"
"#define DEFAULT_SPEED      50"
"#define DEFAULT_BRAKEFLAG  FALSE"
""
"/* Help IDs (pre-built CAR.HLP ships with the sample) */"
"#define ID_HELP_DEFAULT    256"
"#define ID_HELP_DASHBOARD  257"
"#define ID_HELP_OPENCAR    258"
"#define ID_HELP_HORNBEEP   259"
"#define ID_HELP_BEEPHORN   260"
""
"/* Indexes into CARDETAILS information (arrays) */"
"#define  INDEX_MAKE         0"
"#define  INDEX_MODEL        1"
"#define  INDEX_COLOR        2"
"#define  INDEX_SALE_DATE    3"
"#define  INDEX_PRICE        4"
""
"/* CARDETAILS: structure used for details view */"
"typedef struct _CARDETAILS"
"{"
"   PSZ     pszMake;     /* Manufacturer      */"
"   PSZ     pszModel;    /* Model             */"
"   PSZ     pszColor;    /* Color of car      */"
"   CDATE   cdateSale;   /* Date of sale      */"
"   ULONG   ulPrice;     /* Price in dollars  */"
"} CARDETAILS;"
"typedef CARDETAILS *PCARDETAILS;"
"";

      /* C_h_after: appended after the interface declarations in car.h -
       * window/dialog plumbing structures that reference the Car type,
       * so they must come once the class type is known. */
      passthru C_h_after =
"/* Structures storing window-specific data plus a pointer to the object"
" * that created the window/dialog.  They are allocated when the client"
" * window is created, letting our window and dialog procedures recover"
" * somSelf (the system only passes it to methods directly)."
" */"
"typedef struct _WINDOWDATA"
"{"
"   USHORT   cb;            /* size of this structure */"
"   Car     *somSelf;       /* pointer to this instance */"
"   USEITEM  UseItem;       /* global class usage information */"
"   VIEWITEM ViewItem;      /* global class view information */"
"   LONG     x;             /* x position of car in open view */"
"   LONG     y;             /* y position of car in open view */"
"   LONG     xDir;          /* x direction (CAR_LEFT or CAR_RIGHT) */"
"   LONG     yDir;          /* y direction (CAR_UP or CAR_DOWN) */"
"} WINDOWDATA;"
"typedef WINDOWDATA *PWINDOWDATA;"
""
"/* Window data for the Dashboard dialog (settings page) */"
"typedef struct _DASHDLGDATA"
"{"
"   USHORT   cb;            /* size of this structure */"
"   Car    *somSelf;        /* pointer to this instance         */"
"   BOOL    PrevBrakes;     /* indicates if car is stopped      */"
"   ULONG   PrevSpeed;      /* Speed car moves across screen    */"
"} DASHDLGDATA;"
"typedef DASHDLGDATA *PDASHDLGDATA;"
""
"/* Window data for the Horn dialog (settings page) */"
"typedef struct _HORNDLGDATA"
"{"
"   USHORT   cb;            /* size of this structure */"
"   Car    *somSelf;        /* pointer to this instance         */"
"   ULONG   PrevDuration;   /* Duration of the car's horn beep  */"
"   ULONG   PrevHighTone;   /* The high note of the car beep    */"
"   ULONG   PrevLowTone;    /* The low note of the car beep     */"
"} HORNDLGDATA;"
"typedef HORNDLGDATA *PHORNDLGDATA;"
""
"/* Directional multipliers applied against x,y position. */"
"#define CAR_LEFT  -1"
"#define CAR_RIGHT  1"
"#define CAR_DOWN  -1"
"#define CAR_UP     1"
""
"#define ICON_WIDTH   32     /* pels */"
"#define ICON_HEIGHT  32     /* pels */"
"";

      /* NOTE TO MAINTAINERS: the original also emitted a DebugBox macro
       * from this passthru.  Watcom's preprocessor rejected the emitted
       * #if/#else pair (E1100) no matter how it was spelled, so DebugBox
       * is now an ordinary helper defined once in src\car.c. */

      /*
       * Internal Instance Variables
       */
      BOOL  BrakeFlag;              /* indicates if car is stopped */
      ULONG duration;               /* Duration of the car's horn */
      ULONG HighTone;               /* The high note of the beep */
      ULONG LowTone;                /* The low note of the beep */
      ULONG speed;                  /* Speed car moves across screen */

      /*
       * Method Modifiers
       */
      wpInitData:                      override;
      wpUnInitData:                    override;
      wpSaveState:                     override;
      wpRestoreState:                  override;
      wpAddSettingsPages:              override;
      wpFilterPopupMenu:               override;
      wpModifyPopupMenu:               override;
      wpMenuItemSelected:              override;
      wpMenuItemHelpSelected:          override;
      wpQueryDetailsData:              override;
      wpOpen:                          override;
      wpSetup:                         override;
   };
#endif /* __SOMIDL__ */
};

interface M_Car
{
   HMODULE clsQueryModuleHandle();
   /* METHOD: clsQueryModuleHandle
    *   Returns the module handle of this class' DLL.  On first call,
    *   DosQueryModuleHandle resolves the registered pathname.
    * RETURN: 0 unsuccessful, non-zero module handle
    */

#ifdef __SOMIDL__
   implementation
   {
      releaseorder: clsQueryModuleHandle;

      externalstem   = car;
      externalprefix = carM_;
      functionprefix = carM_;
      majorversion   = 1;
      minorversion   = 2;
      filestem       = car;
      callstyle      = oidl;
      dllname        = "car.dll";

      /*
       * Method Modifiers
       */
      wpclsInitData:                   override;
      wpclsUnInitData:                 override;
      wpclsQueryTitle:                 override;
      wpclsQueryIconData:              override;
      wpclsQueryDefaultHelp:           override;
      wpclsQueryDefaultView:           override;
      wpclsQueryDetailsInfo:           override;
      wpclsQueryDetails:               override;
      wpclsQueryInstanceFilter:        override;
      wpclsQueryStyle:                 override;
   };
#endif /* __SOMIDL__ */
};
#endif  /* car_idl */
